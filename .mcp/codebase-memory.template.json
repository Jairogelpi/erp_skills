{
  "mcpServers": {
    "codebase-memory": {
      "command": "__REPOSITORY_ROOT__/.mcp/local/bin/codebase-memory-mcp",
      "cwd": "__REPOSITORY_ROOT__",
      "env": {
        "CBM_ALLOWED_ROOT": "__REPOSITORY_ROOT__",
        "CBM_CACHE_DIR": "__REPOSITORY_ROOT__/.mcp/local/cache",
        "CBM_DIAGNOSTICS": "0",
        "CBM_LOG_LEVEL": "warn"
      }
    }
  },
  "x-tool-policy": {
    "access_mode": "read-mostly",
    "strict_read_only": false,
    "rationale": "Upstream codebase-memory-mcp exposes mutable tools; do not treat this configuration as strict read-only."
  },
