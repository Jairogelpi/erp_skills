# Optional local environment variables. Copy to .env only when a demo needs it.
# Never commit real credentials.
#
# The comparative A/B/C reviewer demo does NOT require any of these variables:
#   uv run python scripts/professor_demo.py
# It runs against FakeERP and reads frozen confirmatory evidence from the repo.

# Optional LLM providers for exploratory/legacy scripts or the live text-to-Odoo demo.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Optional Odoo 19 feasibility demo. Use a Development instance with demo data only.
# Production and staging targets are rejected by require_development_instance().
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
